{
  "name": "dlv-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "frontend:dev": "npm run dev --workspace=apps/frontend",
    "api:dev": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/frontend"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "unrs-resolver@1.12.2": true,
    "@sentry/node-cpu-profiler@2.4.3": true
  }
}
