# Neon PostgreSQL
# Get both URLs from your Neon project dashboard → Connection Details
# DATABASE_URL uses connection pooling (port 6543)
# DIRECT_URL is the direct connection (port 5432) — required for migrations
DATABASE_URL=
DIRECT_URL=
# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_REFRESH_SECRET="change-me-to-another-long-random-secret"

# App
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Chargily
CHARGILY_API_KEY=
CHARGILY_SECRET=
CHARGILY_SUCCESS_URL="http://localhost:5173/payment/success"
CHARGILY_FAILURE_URL="http://localhost:5173/payment/failure"
