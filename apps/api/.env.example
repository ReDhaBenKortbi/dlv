# Neon PostgreSQL
# Get both URLs from your Neon project dashboard → Connection Details
# DATABASE_URL uses connection pooling (port 6543)
# DIRECT_URL is the direct connection (port 5432) — required for migrations
DATABASE_URL=
DIRECT_URL=
# JWT (use a long random string, e.g. `openssl rand -base64 48` — 32+ chars required)
JWT_SECRET=
JWT_REFRESH_SECRET=

# App
# NODE_ENV must be "production" on the deployed API, or the refresh-token
# cookie loses its Secure/SameSite=None flags and browsers will drop it
# (breaks staying logged in across the cross-origin Netlify frontend).
NODE_ENV=development
PORT=3000
FRONTEND_URL=

# Error tracking (optional — leave blank to disable Sentry entirely)
SENTRY_DSN=

# Chargily (mode: test | live)
# CHARGILY_SECRET is used both as the API Bearer token and to verify webhook signatures.
CHARGILY_API_KEY=
CHARGILY_MODE=test
CHARGILY_SECRET=
CHARGILY_SUCCESS_URL=
CHARGILY_FAILURE_URL=
